---
import type { Kategorie } from "../data/produkte";
import { u } from "../lib/url";
interface Props {
  kat: Kategorie;
}
const { kat } = Astro.props;
const anzahl = kat.gruppen.reduce((n, g) => n + g.produkte.length, 0);
---

<!-- V4-Stil: feine Karte, Bild oben, heller Body -->
<a href={u(`/produkte/${kat.slug}`)} class="group flex flex-col rounded-2xl overflow-hidden bg-white border transition-all duration-300 hover:-translate-y-1" style="border-color: var(--color-steel-200);">
  <div class="aspect-[16/10] overflow-hidden" style="background: var(--color-paper-200);">
    <img src={u(kat.image)} alt={kat.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
  </div>
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-2xl mb-2" style="color: var(--color-steel-900);">{kat.name}</h3>
    <p class="text-sm leading-relaxed mb-5 flex-1" style="color: var(--color-steel-500);">{kat.tagline}</p>
    <span class="text-sm font-semibold inline-flex items-center gap-1.5 transition-transform group-hover:translate-x-0.5" style="color: var(--color-apato-600);">
      {anzahl} Produkte
      <svg class="w-3.5 h-3.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h6M6 3l3 3-3 3" stroke-linecap="round"/></svg>
    </span>
  </div>
</a>

<style>
  a:hover { box-shadow: var(--shadow-lift); border-color: transparent; }
</style>
