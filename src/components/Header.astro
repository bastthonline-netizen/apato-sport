---
import { navigation, site } from "../data/site";
import { kategorien } from "../data/produkte";
import { u } from "../lib/url";
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-steel-950)]/95 border-b border-[var(--color-steel-800)] text-white">
  <div class="container-wide flex items-center justify-between h-20">
    <a href={u("/")} class="flex items-center gap-3 group">
      <img src={u("/images/apato/logo.png")} alt="Apato Sport" class="h-11 w-auto transition-transform group-hover:scale-105" />
      <span class="sr-only">{site.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {navigation.map(item => {
        const isActive = currentPath === u(item.href) || (item.href !== "/" && currentPath.startsWith(u(item.href)));
        const isProdukte = item.href === "/produkte";
        if (isProdukte) {
          return (
            <div class="relative group">
              <a
                href={u(item.href)}
                class={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-1 ${isActive ? "bg-[var(--color-apato-600)] text-white" : "text-white/90 hover:bg-white/10"}`}
              >
                {item.label}
                <svg class="w-3 h-3 mt-px transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5l3 3 3-3" stroke-linecap="round"/></svg>
              </a>
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 hidden group-hover:block">
                <div class="w-[640px] rounded-2xl border bg-white shadow-2xl overflow-hidden text-[var(--color-steel-900)]" style="border-color: var(--color-steel-200);">
                  <div class="grid grid-cols-2 gap-1 p-3">
                    {kategorien.map(kat => (
                      <a href={u(`/produkte/${kat.slug}`)} class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-[var(--color-paper-100)] transition-colors">
                        <img src={u(kat.image)} alt="" class="w-11 h-11 rounded-md object-cover flex-shrink-0" style="background: var(--color-paper-200);" loading="lazy" />
                        <span class="leading-tight">
                          <span class="block text-sm font-semibold">{kat.name}</span>
                          <span class="block text-xs" style="color: var(--color-steel-500);">{kat.gruppen.reduce((n, g) => n + g.produkte.length, 0)} Produkte</span>
                        </span>
                      </a>
                    ))}
                  </div>
                  <a href={u("/produkte")} class="block px-5 py-3 text-sm font-semibold border-t bg-[var(--color-paper-50)]" style="border-color: var(--color-steel-200); color: var(--color-apato-600);">
                    Alle Produkte ansehen →
                  </a>
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={u(item.href)}
            class={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${isActive ? "bg-[var(--color-apato-600)] text-white" : "text-white/90 hover:bg-white/10"}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <a href={site.phoneHref} class="text-sm font-semibold text-white/90 hover:text-white transition-colors">{site.phone}</a>
      <a href={u("/kontakt")} class="btn-primary text-sm py-2 px-4">Anfrage senden</a>
    </div>

    <button id="mobile-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Menü öffnen" aria-expanded="false">
      <span class="w-6 h-0.5 bg-white transition-transform"></span>
      <span class="w-6 h-0.5 bg-white transition-opacity"></span>
      <span class="w-6 h-0.5 bg-white transition-transform"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-[var(--color-steel-800)] bg-[var(--color-steel-950)] max-h-[80vh] overflow-y-auto">
    <nav class="container-wide py-6 flex flex-col gap-1">
      <a href={u("/produkte")} class="py-3 px-4 rounded-lg text-base font-semibold text-white hover:bg-white/10">Alle Produkte</a>
      <div class="mt-1 mb-2 pl-2 border-l-2" style="border-color: var(--color-apato-600);">
        {kategorien.map(kat => (
          <a href={u(`/produkte/${kat.slug}`)} class="py-2 px-4 rounded-lg text-sm block text-white/80 hover:bg-white/10">
            {kat.name}
          </a>
        ))}
      </div>
      <a href={u("/ueber-uns")} class="py-3 px-4 rounded-lg text-base font-semibold text-white hover:bg-white/10">Über uns</a>
      <a href={u("/kontakt")} class="py-3 px-4 rounded-lg text-base font-semibold text-white hover:bg-white/10">Kontakt</a>
      <a href={site.phoneHref} class="py-3 px-4 rounded-lg text-base font-semibold text-white/80 hover:bg-white/10">{site.phone}</a>
      <a href={u("/kontakt")} class="btn-primary mt-3 justify-center">Anfrage senden</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(open === false));
  });
</script>
