---
import { site } from "../data/site";
import { kategorien } from "../data/produkte";
import { u } from "../lib/url";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const hauptKategorien = kategorien.slice(0, 6);
---

<footer class="bg-[var(--color-steel-950)] text-white">
  <div class="container-wide py-16 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo variant="light" class="text-2xl mb-5" />
      <p class="text-sm leading-relaxed text-white/70 max-w-xs">
        {site.tagline}. Vom Fußballtor bis zur kompletten Sportanlage — direkt vom Hersteller.
      </p>
      <div class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold" style="background: var(--color-apato-600);">
        ★ Best-Preis-Garantie
      </div>
    </div>

    <div class="md:col-span-4">
      <div class="text-xs uppercase tracking-[0.2em] font-bold mb-4 text-white/50">Produkte</div>
      <ul class="grid grid-cols-2 gap-y-2 text-sm">
        {hauptKategorien.map(kat => (
          <li><a href={u(`/produkte/${kat.slug}`)} class="text-white/75 hover:text-white transition-colors">{kat.name}</a></li>
        ))}
        <li class="col-span-2 mt-1"><a href={u("/produkte")} class="font-semibold" style="color: var(--color-apato-400);">Alle Produkte →</a></li>
      </ul>
    </div>

    <div class="md:col-span-4">
      <div class="text-xs uppercase tracking-[0.2em] font-bold mb-4 text-white/50">Kontakt</div>
      <ul class="space-y-2 text-sm text-white/75">
        <li><a href={site.phoneHref} class="hover:text-white transition-colors">{site.phone}</a></li>
        <li><a href={site.emailHref} class="hover:text-white transition-colors">{site.email}</a></li>
        <li class="pt-1">{site.country}</li>
      </ul>
      <a href={u("/kontakt")} class="btn-primary mt-5 text-sm py-2 px-4">Jetzt anfragen</a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-wide py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/50">
      <div>© {year} {site.name}. Alle Rechte vorbehalten.</div>
      <div class="flex items-center gap-5">
        <a href={u("/impressum")} class="hover:text-white transition-colors">Impressum</a>
        <a href={u("/datenschutz")} class="hover:text-white transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
