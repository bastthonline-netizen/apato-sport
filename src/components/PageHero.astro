---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
}
const { eyebrow, title, subtitle, image } = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--color-steel-950)] text-white">
  {image && (
    <div class="absolute inset-0 -z-0">
      <img src={image} alt="" class="w-full h-full object-cover opacity-30" />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(12,14,18,0.75) 0%, rgba(12,14,18,0.92) 100%);"></div>
    </div>
  )}
  <div class="container-wide relative py-20 md:py-28">
    {eyebrow && <div class="eyebrow mb-4" style="color: var(--color-apato-400);">{eyebrow}</div>}
    <h1 class="text-4xl md:text-6xl max-w-3xl">{title}</h1>
    {subtitle && <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl leading-relaxed">{subtitle}</p>}
    <slot />
  </div>
</section>
