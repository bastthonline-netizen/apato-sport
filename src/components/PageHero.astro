---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string; // bleibt optional kompatibel, wird im editorialen Stil nicht mehr als Vollbild genutzt
}
const { eyebrow, title, subtitle } = Astro.props;
---

<!-- Editorial-Hero: hell, Serif, viel Weißraum (V1-Stil) -->
<section class="border-b" style="background: var(--color-paper-50); border-color: var(--color-steel-200);">
  <div class="container-wide py-16 md:py-24">
    {eyebrow && <div class="eyebrow mb-5">{eyebrow}</div>}
    <h1 class="text-4xl md:text-6xl max-w-3xl" style="color: var(--color-steel-900);" set:html={title} />
    {subtitle && <p class="mt-6 text-lg md:text-xl leading-relaxed max-w-2xl" style="color: var(--color-steel-600);">{subtitle}</p>}
    <slot />
  </div>
</section>
