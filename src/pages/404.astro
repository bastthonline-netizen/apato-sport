---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Seite nicht gefunden">
  <section class="py-28 md:py-40">
    <div class="container-narrow text-center">
      <div class="font-display text-7xl md:text-8xl mb-4" style="color: var(--color-apato-500);">404</div>
      <h1 class="text-3xl md:text-4xl mb-4" style="color: var(--color-steel-900);">Diese Seite gibt's nicht (mehr).</h1>
      <p class="text-lg mb-8" style="color: var(--color-steel-600);">
        Vielleicht hilft Ihnen der Weg zurück zum Sortiment.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="btn-primary">Zur Startseite</a>
        <a href="/produkte" class="btn-outline">Alle Produkte</a>
      </div>
    </div>
  </section>
</Layout>
