---
import Layout from "../layouts/Layout.astro";
import KategorieCard from "../components/KategorieCard.astro";
import { site } from "../data/site";
import { kategorien, produktAnzahl } from "../data/produkte";
import { u } from "../lib/url";
---

<Layout>
  <!-- HERO (Editorial, hell, Serif) -->
  <section class="border-b" style="background: var(--color-paper-50); border-color: var(--color-steel-200);">
    <div class="container-wide pt-16 md:pt-24 pb-10 md:pb-14">
      <div class="eyebrow mb-6">Herstellung &amp; Vertrieb von Sportplatzprodukten</div>
      <h1 class="text-5xl md:text-7xl lg:text-8xl leading-[0.98] max-w-4xl" style="color: var(--color-steel-900);">
        Sportplätze,<br /><em>perfekt ausgestattet.</em>
      </h1>
      <div class="mt-10 grid lg:grid-cols-[1.4fr_1fr] gap-8 lg:gap-12 items-end">
        <p class="text-lg md:text-xl leading-relaxed max-w-xl" style="color: var(--color-steel-600);">
          Vom einzelnen Fußballtor bis zur kompletten Tribüne — Apato Sport fertigt und liefert
          robuste Sportplatzprodukte direkt vom Hersteller. Mit Best-Preis-Garantie.
        </p>
        <div class="flex flex-wrap items-center gap-5 lg:justify-end">
          <a href={u("/produkte")} class="btn-primary text-base">Produkte ansehen</a>
          <a href={u("/kontakt")} class="btn-link">Angebot anfragen →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE-BILD -->
  <section class="container-wide pt-8 md:pt-10">
    <div class="overflow-hidden rounded-2xl">
      <img src={u("/images/apato/banner05.jpg")} alt="Sportplatz von Apato Sport" class="w-full object-cover" style="height: clamp(280px, 48vh, 560px);" loading="eager" />
    </div>
  </section>

  <!-- KENNZAHLEN (editorial, dünne Linien) -->
  <section class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-b pb-12" style="border-color: var(--color-steel-200);">
      {[
        { value: `${kategorien.length}`, label: "Kategorien" },
        { value: `${produktAnzahl}+`, label: "Produkte" },
        { value: "★", label: "Best-Preis-Garantie" },
        { value: "3 J.", label: "Garantie auf Tore" },
      ].map((stat) => (
        <div>
          <div class="font-display text-4xl md:text-5xl mb-1" style="color: var(--color-steel-900);">{stat.value}</div>
          <div class="text-xs uppercase tracking-[0.14em] font-semibold" style="color: var(--color-steel-500);">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- USP (editorial) -->
  <section class="container-wide pb-8 md:pb-16">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <div class="eyebrow mb-4">Warum Apato Sport</div>
        <h2 class="text-4xl md:text-5xl" style="color: var(--color-steel-900);">Herstellerqualität,<br/><em>fair im Preis.</em></h2>
      </div>
      <div class="lg:col-span-8 grid sm:grid-cols-3 gap-x-8 gap-y-10">
        {site.usp.map(u => (
          <div>
            <div class="text-3xl mb-3" style="color: var(--color-apato-500); font-family: var(--font-display);">—</div>
            <h3 class="text-xl mb-2" style="color: var(--color-steel-900);">{u.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-steel-600);">{u.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KATEGORIEN (V4-Grid) -->
  <section class="py-16 md:py-24" style="background: var(--color-paper-100);">
    <div class="container-wide">
      <div class="flex items-end justify-between flex-wrap gap-6 mb-12">
        <div class="max-w-2xl">
          <div class="eyebrow mb-4">Das Sortiment</div>
          <h2 class="text-4xl md:text-5xl" style="color: var(--color-steel-900);">Neun Kategorien für<br/><em>den ganzen Platz.</em></h2>
        </div>
        <a href={u("/produkte")} class="btn-link">Alle Produkte →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {kategorien.map(kat => <KategorieCard kat={kat} />)}
      </div>
    </div>
  </section>

  <!-- BILDBANNER -->
  <section class="relative h-[48vh] md:h-[58vh] overflow-hidden">
    <img src={u("/images/apato/banner08.jpg")} alt="Öffentliche Sportanlage von Apato Sport" class="w-full h-full object-cover" />
    <div class="absolute inset-0 flex items-center" style="background: linear-gradient(90deg, rgba(12,14,18,0.88) 0%, rgba(12,14,18,0.4) 60%, transparent 100%);">
      <div class="container-wide">
        <div class="max-w-xl text-white">
          <div class="eyebrow mb-4" style="color: var(--color-apato-400);">Öffentliche Anlagen</div>
          <h2 class="text-4xl md:text-5xl mb-5 text-white">Sicher spielen, sicher Sport treiben.</h2>
          <p class="text-lg leading-relaxed text-white/85 mb-7">
            Bolzplatz-Tore, Soccer Courts und Multifunktions-Sportplätze für Kommunen, Schulen und Vereine — robust und langlebig.
          </p>
          <a href={u("/produkte/oeffentliche-anlagen")} class="btn-primary">
            Öffentliche Anlagen ansehen
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="container-wide">
      <div class="rounded-3xl p-10 md:p-16 text-center text-white relative overflow-hidden" style="background: var(--color-steel-900);">
        <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full opacity-10" style="background: var(--color-apato-500);"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl mb-5">Sie planen ein Projekt?</h2>
          <p class="text-lg text-white/80 max-w-xl mx-auto mb-9">
            Schildern Sie uns Ihr Vorhaben — wir erstellen Ihnen ein passendes Angebot mit Best-Preis-Garantie.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href={u("/kontakt")} class="btn-primary text-base">Anfrage senden</a>
            <a href={site.phoneHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold border border-white/30 text-white hover:bg-white/10 transition-all">{site.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
